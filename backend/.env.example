# Template only: no real values. Copy to backend/.env for local runs without Docker.
# On Render/Railway set these in the service's environment settings (see DEPLOYMENT.md).
# Comments stay on their own lines so values can be pasted into a platform UI as-is.

# PostgreSQL connection string. postgres:// and postgresql:// are both accepted.
DATABASE_URL=postgresql://user:password@host:5432/ecom_pulse

# Exact frontend origins allowed by CORS, comma-separated (scheme + host, no path).
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional regex for Vercel preview URLs.
# ALLOWED_ORIGIN_REGEX=https://your-app-[a-z0-9-]+-yourteam\.vercel\.app

# Public demo: seed data read-only, visitor uploads go to private 24h sandboxes.
DEMO_MODE=true
SEED_ON_STARTUP=true
SANDBOX_TTL_HOURS=24
MAX_SANDBOXES=200

# Display-only ₹/$ conversion rate.
USD_INR_RATE=84
