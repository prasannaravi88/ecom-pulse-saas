# Public URL of the FastAPI backend (no trailing slash). Inlined at build time.
# Local dev: `cp .env.example .env.local` works as-is with the backend on :8000.
# Production: set the deployed backend URL (e.g. https://your-backend.up.railway.app)
# in Vercel → Project → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8000
